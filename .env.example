# Copy to .env.local and fill in (never commit .env.local).
# Expo loads this for app.config.js and EXPO_PUBLIC_* client vars.

# Sentry — runtime error reporting (embedded in app; not a secret)
EXPO_PUBLIC_SENTRY_DSN=

# Sentry — native build plugin (source maps / debug symbols)
SENTRY_ORG=
SENTRY_PROJECT=

# Apple — iOS code signing (app.config.js + archive_ios export)
APPLE_TEAM_ID=

# App Store Connect API (archive_ios upload)
# ASC_KEY_ID=
# ASC_ISSUER_ID=

# Android signing + Play upload (archive_android) — see README Release builds
# ANDROID_KEYSTORE_PATH=private_keys/android-release.jks
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
# PLAY_SERVICE_ACCOUNT_JSON=private_keys/play-service-account.json
# PLAY_TRACK=internal
