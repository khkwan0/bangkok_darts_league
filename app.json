{
  "expo": {
    "name": "Bangkok Darts League",
    "slug": "bangkok_darts_league",
    "version": "1.01",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bangkokdartsleague",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bangkok-darts-league",
      "buildNumber": "5",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "webcredentials:darts.bkkleague.com",
        "applinks:darts.bkkleague.com"
      ],
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.applesignin": ["Default"]
      },
      "infoPlist": {
        "CFBundleDisplayName": "Bangkok Darts League",
        "LSApplicationCategoryType": "public.app-category.sports",
        "UIBackgroundModes": ["fetch", "remote-notification"],
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone",
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photos",
        "LSApplicationQueriesSchemes": ["lineauth2"],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "bangkokdartsleague",
              "com.bangkok-darts-league"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.bangkok_darts_league",
      "versionCode": 5,
      "googleServicesFile": "./firebase.google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#F5F5F5"
    },
    "androidNavigationBar": {
      "backgroundColor": "#F5F5F5",
      "barStyle": "dark-content"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withAndroidFirebaseNotificationManifest",
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#111111",
          "dark": {
            "backgroundColor": "#111111"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": ["RNFBApp", "RNFBMessaging"]
          },
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "defaultChannel": "General"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@xmartlabs/react-native-line",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "./plugins/withIosMarketingVersion",
      "./plugins/withIosSignEmbeddedFrameworks",
      "./plugins/withAndroidReleaseSigning",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "bangkok-darts-league",
          "organization": "nitrox-studios"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
