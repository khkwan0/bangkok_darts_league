{
  "expo": {
    "name": "Bangkok Darts League",
    "slug": "bangkok_darts_league",
    "version": "1.18",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "bangkokdartsleague",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bangkok-darts-league",
      "buildNumber": "22",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "webcredentials:darts.bkkleague.com",
        "applinks:darts.bkkleague.com"
      ],
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.applesignin": ["Default"]
      },
      "infoPlist": {
        "CFBundleDisplayName": "Bangkok Darts League",
        "LSApplicationCategoryType": "public.app-category.sports",
        "UIBackgroundModes": ["fetch", "remote-notification"],
        "NSCameraUsageDescription": "Bangkok Darts League uses the camera to take your player profile photo or team logo, and to scan a player QR code when adding someone to a team. For example, you can take a photo of yourself to set as your profile picture.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone",
        "NSPhotoLibraryUsageDescription": "Bangkok Darts League uses your photo library so you can choose a profile photo or team logo, attach a picture to a chat, forum post, or support request, or add a photo or video to a league announcement. For example, you can select a photo from your library to use as your profile picture.",
        "LSApplicationQueriesSchemes": ["lineauth2"],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "bangkokdartsleague",
              "com.bangkok-darts-league"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.bangkok_darts_league",
      "versionCode": 22,
      "googleServicesFile": "./firebase.google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "darts.bkkleague.com",
              "pathPrefix": "/player"
            }
          ]
        }
      ],
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#F5F5F5"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withAndroidFirebaseNotificationManifest",
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#111111",
          "dark": {
            "backgroundColor": "#111111"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": ["RNFBApp", "RNFBMessaging"]
          },
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withAndroidKeepCoinFlipResources",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "defaultChannel": "General"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bangkok Darts League uses your photo library so you can choose a profile photo or team logo, attach a picture to a chat, forum post, or support request, or add a photo or video to a league announcement. For example, you can select a photo from your library to use as your profile picture.",
          "cameraPermission": "Bangkok Darts League uses the camera to take your player profile photo or team logo, and to scan a player QR code when adding someone to a team. For example, you can take a photo of yourself to set as your profile picture.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Bangkok Darts League uses the camera to take your player profile photo or team logo, and to scan a player QR code when adding someone to a team. For example, you can take a photo of yourself to set as your profile picture.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "./plugins/withFirebaseAppDelegate",
      "./plugins/withLineSDK",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-video",
      "expo-status-bar",
      "./plugins/withIosMarketingVersion",
      "./plugins/withIosSignEmbeddedFrameworks",
      "./plugins/withAndroidReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
